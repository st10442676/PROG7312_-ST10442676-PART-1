<aside class="sidebar @(menuOpen ? "sidebar-open" : string.Empty)">
    <div class="brand">
        <div class="brand-mark" aria-hidden="true">
            <span class="brand-core"></span>
        </div>

        <div class="brand-copy">
            <strong>SMART-X</strong>
            <span>IoT Gateway</span>
        </div>
    </div>

    <div class="environment-label">
        <span></span>
        Part 1 workspace
    </div>

    <nav class="navigation" aria-label="Primary navigation">
        <p class="navigation-heading">Workspace</p>

        <NavLink class="navigation-item"
                 href=""
                 Match="NavLinkMatch.All"
                 @onclick="CloseMenu">

            <span class="navigation-icon" aria-hidden="true">⌂</span>

            <span>
                <strong>Overview</strong>
                <small>Gateway command centre</small>
            </span>
        </NavLink>

        <NavLink class="navigation-item"
                 href="sensors/register"
                 @onclick="CloseMenu">

            <span class="navigation-icon" aria-hidden="true">◉</span>

            <span>
                <strong>Sensors</strong>
                <small>Registration and profiles</small>
            </span>

            <span class="live-badge">Live</span>
        </NavLink>

        <div class="navigation-item navigation-item-disabled"
             title="Telemetry interface deferred">

            <span class="navigation-icon" aria-hidden="true">⌁</span>

            <span>
                <strong>Telemetry</strong>
                <small>Live measurements</small>
            </span>

            <span class="soon-badge">Deferred</span>
        </div>

        <NavLink class="navigation-item"
                 href="attachments"
                 @onclick="CloseMenu">

            <span class="navigation-icon" aria-hidden="true">▱</span>

            <span>
                <strong>Attachments</strong>
                <small>Encrypted sensor files</small>
            </span>

            <span class="live-badge">Live</span>
        </NavLink>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="security-card">
        <div class="security-icon" aria-hidden="true">◆</div>

        <div>
            <strong>Encrypted storage</strong>

            <p>
                AES-256 protection is active for uploaded sensor files.
            </p>
        </div>
    </div>

    <div class="sidebar-footer">
        <span>SMART-X CORE</span>
        <span>v1.0</span>
    </div>
</aside>

@if (menuOpen)
{
    <button class="menu-backdrop"
            type="button"
            aria-label="Close navigation menu"
            @onclick="CloseMenu">
    </button>
}

<button class="mobile-menu-button"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="@menuOpen"
        @onclick="ToggleMenu">

    <span></span>
    <span></span>
    <span></span>
</button>

@code {
    private bool menuOpen;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void CloseMenu()
    {
        menuOpen = false;
    }
}