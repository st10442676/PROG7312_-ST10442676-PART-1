<aside class="sidebar @(menuOpen ? "sidebar-open" : string.Empty)">
    <div class="brand">
        <div class="brand-mark" aria-hidden="true">
            <span class="brand-core"></span>
        </div>

        <div class="brand-copy">
            <strong>SMART-X</strong>
            <span>Connected operations</span>
        </div>
    </div>

    <div class="environment-label">
        <span></span>
        Part 1 · Live workspace
    </div>

    <nav class="navigation" aria-label="Primary navigation">
        <p class="navigation-heading">Your workspace</p>

        <NavLink class="navigation-item"
                 href=""
                 Match="NavLinkMatch.All"
                 @onclick="CloseMenu">

            <span class="navigation-icon" aria-hidden="true">
                ⌂
            </span>

            <span>
                <strong>Overview</strong>
                <small>A clear view of the gateway</small>
            </span>
        </NavLink>

        <NavLink class="navigation-item"
                 href="sensors/register"
                 @onclick="CloseMenu">

            <span class="navigation-icon" aria-hidden="true">
                ◉
            </span>

            <span>
                <strong>Sensors</strong>
                <small>Register and manage devices</small>
            </span>

            <span class="live-badge">Live</span>
        </NavLink>

        <NavLink class="navigation-item"
                 href="telemetry"
                 @onclick="CloseMenu">

            <span class="navigation-icon" aria-hidden="true">
                ⌁
            </span>

            <span>
                <strong>Telemetry</strong>
                <small>Live sensor measurements</small>
            </span>

            <span class="live-badge">Live</span>
        </NavLink>

        <NavLink class="navigation-item"
                 href="attachments"
                 @onclick="CloseMenu">

            <span class="navigation-icon" aria-hidden="true">
                ▱
            </span>

            <span>
                <strong>Attachments</strong>
                <small>Keep sensor files protected</small>
            </span>

            <span class="live-badge">Live</span>
        </NavLink>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="security-card">
        <div class="security-icon" aria-hidden="true">
            ◆
        </div>

        <div>
            <strong>Protected by design</strong>

            <p>
                Every upload is encrypted before it reaches storage.
            </p>
        </div>
    </div>

    <div class="sidebar-footer">
        <span>SMART-X CORE</span>
        <span>v1.0</span>
    </div>
</aside>

@if (menuOpen)
{
    <button class="menu-backdrop"
            type="button"
            aria-label="Close navigation menu"
            @onclick="CloseMenu">
    </button>
}

<button class="mobile-menu-button"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="@menuOpen"
        @onclick="ToggleMenu">

    <span></span>
    <span></span>
    <span></span>
</button>

@code {
    private bool menuOpen;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void CloseMenu()
    {
        menuOpen = false;
    }
}